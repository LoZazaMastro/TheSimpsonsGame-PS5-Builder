<Window x:Class="Simpsons.Builder.Desktop.ColourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Choose colour" Width="540" Height="510" MinWidth="420" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="Transparent"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowSurface" CornerRadius="12" Background="{DynamicResource WindowBackdrop}" BorderBrush="{DynamicResource SurfaceStroke}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Choose colour" Margin="22,0,52,0" VerticalAlignment="Center"/>
      <Button Content="&#xE8BB;" Style="{StaticResource CloseWindowButton}" HorizontalAlignment="Right" Click="Close_Click"
              shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,14,26,8">
        <StackPanel>
          <Border Height="70" Background="{Binding PreviewBrush}" BorderBrush="#808080" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Red" VerticalAlignment="Center"/><Slider Grid.Column="1" Value="{Binding Red, Mode=TwoWay}" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource DarkSlider}" Margin="0,8" AutomationProperties.Name="Red"/><TextBlock Grid.Column="2" Text="{Binding Red, StringFormat=0}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="Green" VerticalAlignment="Center"/><Slider Grid.Row="1" Grid.Column="1" Value="{Binding Green, Mode=TwoWay}" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource DarkSlider}" Margin="0,8" AutomationProperties.Name="Green"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green, StringFormat=0}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="2" Text="Blue" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" Value="{Binding Blue, Mode=TwoWay}" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource DarkSlider}" Margin="0,8" AutomationProperties.Name="Blue"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue, StringFormat=0}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <TextBlock Text="Hex colour" Style="{StaticResource CaptionText}" Margin="0,18,0,7"/>
          <TextBox Text="{Binding SelectedHex, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Selected hex colour"/>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,18,24,24">
        <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,10,0" IsCancel="True" Click="Close_Click"/>
        <Button Content="Use colour" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Accept_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
