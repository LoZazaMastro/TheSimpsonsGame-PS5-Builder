<Window x:Class="Simpsons.Builder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Simpsons.Builder.Desktop"
        Title="The Simpsons Game · PS5 Builder" Icon="Assets/builder.ico"
        Width="1220" Height="840" MinWidth="840" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged" StateChanged="Window_StateChanged"
        Closing="Window_Closing" Closed="Window_Closed">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" GlassFrameThickness="0"
                        CornerRadius="12" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>

    <DataTemplate x:Key="SettingTemplate" DataType="{x:Type local:SettingViewModel}">
      <Border BorderBrush="{DynamicResource SurfaceStroke}" BorderThickness="0,0,0,1" Padding="0,16,0,18">
        <StackPanel>
          <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Border Background="#24FFCB0F" CornerRadius="4" Padding="7,3"
                    Visibility="{Binding IsExperimental, Converter={StaticResource VisibleIfTrue}}">
              <TextBlock Text="Experimental" FontSize="11" Foreground="{DynamicResource Accent}"/>
            </Border>
          </WrapPanel>
          <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,0,0,10"/>
          <Grid IsEnabled="{Binding IsEnabled}">
            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                      Style="{StaticResource DarkComboBox}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{Binding Label}" ToolTip="{Binding CurrentLabel}"
                      Visibility="{Binding IsChoice, Converter={StaticResource VisibleIfTrue}}"/>
            <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" Content="{Binding OnOffLabel}" Style="{StaticResource DarkCheck}"
                      AutomationProperties.Name="{Binding Label}"
                      Visibility="{Binding IsBoolean, Converter={StaticResource VisibleIfTrue}}"/>
            <Grid Visibility="{Binding IsNumber, Converter={StaticResource VisibleIfTrue}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <Slider Value="{Binding NumericValue, Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        TickFrequency="{Binding TickFrequency}" SmallChange="{Binding TickFrequency}" IsSnapToTickEnabled="True" Style="{StaticResource DarkSlider}"
                        AutomationProperties.Name="{Binding Label}"/>
                <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
              </StackPanel>
              <TextBox Grid.Column="1" Width="100" VerticalAlignment="Top" TextAlignment="Center"
                       Text="{Binding NumericText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{Binding Label}"/>
            </Grid>
            <Grid Visibility="{Binding IsColor, Converter={StaticResource VisibleIfTrue}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Background="{Binding ColorBrush}" BorderBrush="#808080" BorderThickness="1" CornerRadius="6" Margin="0,2,8,2"/>
              <TextBox Grid.Column="1" Text="{Binding ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{Binding Label}" MinWidth="100"/>
              <Button Grid.Column="2" Content="Choose colour" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="ChooseColour_Click"/>
            </Grid>
          </Grid>
          <TextBlock Text="{Binding Hint}" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                     Visibility="{Binding HasHint, Converter={StaticResource VisibleIfTrue}}"/>
          <TextBlock Text="{Binding ValidationError}" Foreground="#FF9393" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding HasError, Converter={StaticResource VisibleIfTrue}}"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="GroupTemplate" DataType="{x:Type local:SettingGroupViewModel}">
      <StackPanel>
        <TextBlock Text="{Binding Label}" Style="{StaticResource SectionHeading}" Margin="0,6,0,4"/>
        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,0,0,12"
                   Visibility="{Binding HasDescription, Converter={StaticResource VisibleIfTrue}}"/>
        <Border Style="{StaticResource Card}" Margin="0,14,0,8"
                Visibility="{Binding RequiresLossless, Converter={StaticResource VisibleIfTrue}}">
          <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <TextBlock Text="Your Lossless.dll" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="Choose your file to unlock frame generation." Style="{StaticResource BodyText}" Margin="0,6,0,12"/>
            <TextBox Text="{Binding LosslessPathDisplay, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding LosslessPathDisplay}"
                     AutomationProperties.Name="Lossless DLL path"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="Choose file" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="ChooseLossless_Click"/>
              <Button Content="Remove" Style="{StaticResource GhostButton}" IsEnabled="{Binding LosslessAvailable}" Click="RemoveLossless_Click"/>
            </WrapPanel>
            <TextBlock Text="{Binding LosslessStatus}" Style="{StaticResource BodyText}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel Margin="0,14,0,4" Visibility="{Binding HasPresets, Converter={StaticResource VisibleIfTrue}}">
          <TextBlock Text="Preset" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" AutomationProperties.Name="Preset"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Settings}" ItemTemplate="{StaticResource SettingTemplate}"/>
        <StackPanel Margin="0,20,0,0" Visibility="{Binding IsGame, Converter={StaticResource VisibleIfTrue}}">
          <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <CheckBox Content="Skip intro logo videos" IsChecked="{Binding SkipIntro, Mode=TwoWay}" Style="{StaticResource DarkCheck}"/>
            <TextBlock Text="Original logo files are kept in the output so this can be reversed." Style="{StaticResource BodyText}" Margin="0,8,0,20"/>
            <TextBlock Text="Starting episode · Experimental" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode, Mode=TwoWay}"
                      IsEnabled="{Binding HasEpisodes}" AutomationProperties.Name="Starting episode"/>
            <TextBlock Text="{Binding EpisodeNote}" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SummaryTemplate">
      <Grid Margin="0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,16,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="WindowSurface" CornerRadius="12" Background="{DynamicResource WindowBackdrop}"
          BorderBrush="{DynamicResource SurfaceStroke}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="Transparent">
        <TextBlock Text="The Simpsons Game · PS5 Builder" Style="{StaticResource CaptionText}" Margin="20,0,152,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="CompactAboutButton" Content="&#xE946;" Style="{StaticResource WindowButton}" Click="About_Click"
                  Visibility="Collapsed" ToolTip="About and logs" AutomationProperties.Name="About and logs"/>
          <Button Content="&#xE921;" Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
          <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore"/>
          <Button Content="&#xE8BB;" Style="{StaticResource CloseWindowButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="#26000000" BorderBrush="{DynamicResource SurfaceStroke}" BorderThickness="0,0,1,0">
          <Grid Margin="22,24,22,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="4,0,4,22">
              <Border Background="{DynamicResource Accent}" Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,18">
                <Viewbox Width="28" Height="28">
                  <Canvas Width="32" Height="32">
                    <Path Data="M3,9 L12,9 L15,12 L29,12 L29,26 L3,26 Z M3,9 L3,6 L12,6 L15,9 L26,9 L26,12"
                          Stroke="#1A1A1A" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                    <Path Data="M16,16 L16,22 M13,19 L16,22 L19,19" Stroke="#1A1A1A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <TextBlock Text="PS5 Builder" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="The Simpsons Game" Style="{StaticResource BodyText}" Margin="0,7,0,0"/>
              <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel IsEnabled="{Binding CanNavigate}">
                <RadioButton Content="1. Game files" Tag="0" GroupName="Steps" Style="{StaticResource NavButton}" IsChecked="{Binding IsFilesPage, Mode=OneWay}" Checked="Navigation_Checked" Margin="0,0,0,8"/>
                <RadioButton Content="2. Settings" Tag="1" GroupName="Steps" Style="{StaticResource NavButton}" IsChecked="{Binding IsSettingsPage, Mode=OneWay}" Checked="Navigation_Checked" Margin="0,0,0,8"/>
                <RadioButton Content="3. Language" Tag="2" GroupName="Steps" Style="{StaticResource NavButton}" IsChecked="{Binding IsLanguagePage, Mode=OneWay}" Checked="Navigation_Checked" Margin="0,0,0,8"/>
                <RadioButton Content="4. Build" Tag="3" GroupName="Steps" Style="{StaticResource NavButton}" IsChecked="{Binding IsBuildPage, Mode=OneWay}" Checked="Navigation_Checked"/>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
              <Button Content="Open logs" Style="{StaticResource GhostButton}" Click="OpenLogs_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
              <Button Content="About" Style="{StaticResource GhostButton}" Click="About_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
              <Button x:Name="DonateButton" Content="Donate" Style="{StaticResource PrimaryButton}" Click="Donate_Click" HorizontalAlignment="Stretch"
                      ToolTip="Support LoZazaMastro on Ko-fi" AutomationProperties.Name="Donate"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="1" x:Name="MainArea" Margin="32,22,32,20">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,22">
            <TextBlock Text="{Binding StepLabel}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
          </StackPanel>

          <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,12">
            <Grid>
              <StackPanel x:Name="FilesPage" Visibility="{Binding IsFilesPage, Converter={StaticResource VisibleIfTrue}}">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Game source" Style="{StaticResource SectionHeading}" Margin="0,0,0,14"/>
                    <ComboBox x:Name="SourceKindBox" ItemsSource="{Binding SourceKinds}" SelectedIndex="{Binding InputKindIndex, Mode=TwoWay}" AutomationProperties.Name="Game source type" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding SourcePathLabel}" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBox x:Name="SourcePathBox" Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="SourcePath_LostFocus"
                               AutomationProperties.Name="Game source path" ToolTip="{Binding InputPath}"/>
                      <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="BrowseSource_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding InputStatus}" Foreground="{Binding InputStatusBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                  <StackPanel>
                    <TextBlock Text="Output folder" Style="{StaticResource SectionHeading}"/>
                    <TextBlock Text="A new PPSA74207 folder will be created here." Style="{StaticResource BodyText}" Margin="0,7,0,14"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBox x:Name="OutputPathBox" Text="{Binding OutputParent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="Output parent folder" ToolTip="{Binding OutputParent}"/>
                      <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="BrowseOutput_Click"/>
                    </Grid>
                    <TextBlock Text="Use an empty destination. An existing PPSA74207 folder will be kept intact." Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="Recommended settings: 4K · 60 FPS · English. You can change them in the next steps." Style="{StaticResource BodyText}" Margin="0,20,0,0"/>
              </StackPanel>

              <StackPanel x:Name="SettingsPage" Visibility="{Binding IsSettingsPage, Converter={StaticResource VisibleIfTrue}}">
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Category" Style="{StaticResource CaptionText}" Margin="0,0,0,7"/>
                    <ComboBox x:Name="CategoryBox" ItemsSource="{Binding SettingGroups}"
                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" AutomationProperties.Name="Settings category"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Reset settings" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="RestoreRecommended_Click"/>
                </Grid>
                <ContentControl x:Name="SettingsContent" Content="{Binding SelectedGroup}" ContentTemplate="{StaticResource GroupTemplate}" HorizontalContentAlignment="Stretch"/>
              </StackPanel>

              <StackPanel x:Name="LanguagePage" Visibility="{Binding IsLanguagePage, Converter={StaticResource VisibleIfTrue}}">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Game language" Style="{StaticResource SectionHeading}"/>
                    <ItemsControl ItemsSource="{Binding LanguageSettings}" ItemTemplate="{StaticResource SettingTemplate}"/>
                    <TextBlock Text="English is selected by default. Choose a language included on your disc." Style="{StaticResource BodyText}" Margin="0,16,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="BuildPage" Visibility="{Binding IsBuildPage, Converter={StaticResource VisibleIfTrue}}">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding BuildSummaryHeading}" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding SummaryRows}" ItemTemplate="{StaticResource SummaryTemplate}"/>
                    <Button Content="{Binding SummaryToggleLabel}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ToggleSummary_Click"/>
                    <ItemsControl ItemsSource="{Binding FullSummaryRows}" ItemTemplate="{StaticResource SummaryTemplate}" Margin="0,14,0,0"
                                  Visibility="{Binding ShowFullSummary, Converter={StaticResource VisibleIfTrue}}"/>
                    <TextBlock Text="{Binding BuildHint}" Style="{StaticResource BodyText}" Margin="0,16,0,0"/>
                    <Button Content="Open output folder" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"
                            Click="OpenOutput_Click" Visibility="{Binding BuildComplete, Converter={StaticResource VisibleIfTrue}}"/>
                  </StackPanel>
                </Border>
                <StackPanel Margin="0,22,0,0">
                  <TextBlock Text="{Binding ProgressPhase}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Style="{StaticResource FluentProgress}" Margin="0,13,0,10"/>
                  <TextBlock Text="{Binding ProgressFile}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" ToolTip="{Binding ProgressFile}"/>
                  <TextBlock Text="{Binding ProgressNumbers}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                  <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Foreground="{Binding OutcomeBrush}" Margin="0,10,0,0"/>
                </StackPanel>
                <Border BorderBrush="{DynamicResource SurfaceStroke}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                  <StackPanel>
                    <Button Content="{Binding LogToggleLabel}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="ToggleLog_Click"/>
                    <TextBox x:Name="LiveLogBox" Text="{Binding LogExcerpt, Mode=OneWay}" Height="190" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Margin="0,12,0,0" Visibility="{Binding ShowLog, Converter={StaticResource VisibleIfTrue}}" AutomationProperties.Name="Live builder log"/>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Content="Copy diagnostics" Style="{StaticResource GhostButton}" Margin="0,0,10,8" Click="CopyDiagnostics_Click"/>
                      <Button Content="Export full log" Style="{StaticResource GhostButton}" Margin="0,0,0,8" Click="ExportLog_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <Grid x:Name="ActionBar" Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="Back" Style="{StaticResource GhostButton}" IsEnabled="{Binding CanBack}" Click="Back_Click" VerticalAlignment="Top"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
              <Button Content="{Binding CancelLabel}" Style="{StaticResource GhostButton}" IsEnabled="{Binding CanCancel}" Click="Cancel_Click" Margin="0,0,10,4"/>
              <Button x:Name="NextButton" Content="{Binding NextLabel}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanNext}" Click="Next_Click" MinWidth="150" Margin="0,0,0,4"/>
            </WrapPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
