# Native PS5 cross compilation. Uses the public, pinned PayloadSDK fork.
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(REXGLUE_PLATFORM_PROSPERO ON CACHE BOOL "" FORCE)
set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "Installed PS5 payload SDK")
if(NOT EXISTS "${PS5_PAYLOAD_SDK}/target/include/ps5platform/context.h")
    message(FATAL_ERROR "PS5_PAYLOAD_SDK must point to the pinned PS5_PayloadSDK fork with ps5platform")
endif()
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_SYSROOT "${PS5_PAYLOAD_SDK}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-fPIC -fno-plt -fno-stack-protector -femulated-tls -fvisibility-nodllstorageclass=default -fdenormal-fp-math=ieee -D__PROSPERO__ -DREX_PLATFORM_PROSPERO=1 -isystem \"${PS5_PAYLOAD_SDK}/target/include\"")
# The PS5 target disables these by default; the runtime uses both C++ exception
# unwinding and dynamic_cast. Keep libc++ headers before the C SDK headers.
set(CMAKE_CXX_FLAGS_INIT "-isystem \"${PS5_PAYLOAD_SDK}/target/include/c++/v1\" -fexceptions -fcxx-exceptions -frtti ${CMAKE_C_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "${PS5_PAYLOAD_SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(CMAKE_CXX_LINK_EXECUTABLE "bash \"${CMAKE_CURRENT_LIST_DIR}/link.sh\" <OBJECTS> <LINK_LIBRARIES> -o <TARGET>")
set(CMAKE_C_LINK_EXECUTABLE "${CMAKE_CXX_LINK_EXECUTABLE}")
